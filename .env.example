# Copy to .env and edit. docker compose reads .env automatically; it is ignored by git.
# Every line is optional - the value shown is the default.

# Which published build to run. `latest` follows the newest one; a version number (as shown
# at the bottom of the UI) stays on that build until you change it.
GRIMTORRENTER_TAG=latest

# Uncomment to build the image from this source tree instead of pulling it (needs a full
# clone of the repository, not just the compose file).
#COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml

# User and group the app runs as. Use the ids of the host user that owns the directories
# below (run `id -u` and `id -g` as that user). 0 and 0 runs as root, as older images did.
PUID=1000
PGID=1000

# Where the web UI is reachable on the host.
GRIMTORRENTER_HTTP_PORT=8080

# BitTorrent port (tcp + udp). Forward this port on your router for incoming connections.
# Some networks throttle or block 6881; any free port works.
GRIMTORRENTER_LISTEN_PORT=6881

# Host directories. Downloaded data, the app's own settings/state, and the watch folder.
GRIMTORRENTER_DOWNLOADS=./data/downloads
GRIMTORRENTER_CONFIG=./data/config
GRIMTORRENTER_WATCH=./data/watch
